# Copia este archivo como backend/.env y rellena tus valores. NUNCA subas .env a GitHub.

# Puerto y dirección de escucha
PORT=8787
HOST=0.0.0.0

# Código que escribirás en el juego (Ajustes → Voz e IA → Código de acceso).
# Sin él, cualquiera que conozca la URL podría gastar tu saldo de IA.
APP_ACCESS_CODE=cambia-esto-por-un-codigo-largo

# Secreto para firmar sesiones (cadena aleatoria larga). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=pon-aqui-64-caracteres-aleatorios
TOKEN_TTL_SEC=21600

# --- Conversación (LLM) ---
# anthropic = Claude (de pago por uso) · mock = respuestas de prueba sin IA
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-haiku-5-5
MAX_REPLY_TOKENS=400

# --- Voz (OpenAI, de pago por uso) ---
# STT_PROVIDER: openai | none     TTS_PROVIDER: openai | none
STT_PROVIDER=openai
TTS_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# --- Límites y protección contra abuso ---
UPSTREAM_TIMEOUT_MS=12000
RATE_LIMIT_PER_MIN=40
DAILY_REQUESTS_PER_DEVICE=800
DAILY_TTS_CHARS_PER_DEVICE=40000
DAILY_STT_SECONDS_PER_DEVICE=1800
MAX_JSON_BYTES=32768
MAX_AUDIO_BYTES=1048576
LOG_REQUESTS=1
