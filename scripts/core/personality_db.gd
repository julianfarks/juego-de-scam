static func ids() -> Array:
	return P.keys()


static func get_p(id: String) -> Dictionary:
	return P.get(id, P["educado_firme"])


static func line(id: String, category: String, rng: RandomNumberGenerator) -> String:
	var p := get_p(id)
	var arr: Array = p["lines"].get(category, [])
	if arr.is_empty():
		return ""
	return arr[rng.randi() % arr.size()]


static func has_quirk(id: String, quirk: String) -> bool:
	return get_p(id)["quirks"].has(quirk)
